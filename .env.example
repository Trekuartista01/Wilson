# Copy to .env.local (never committed) and fill in every value. None has a default:
# the server refuses to start in production if any of these is missing.

# --- Supabase (Project Settings > API Keys) ---
SUPABASE_URL=
# The SECRET key (sb_secret_..., or the legacy service_role key). Not the publishable key.
# Server only: never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin login ---
ADMIN_USERNAME=
# bcrypt hash of the admin password, never the password itself.
# Generate with: npm run hash-password   (paste the line it prints, with the \$ escapes)
ADMIN_PASSWORD_HASH=
# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# --- Email (contact form) ---
SMTP_HOST=
# 465 (TLS) or 587 (STARTTLS). Unencrypted SMTP is refused.
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Sender shown on the email, e.g. Wilson Website <no-reply@wilsonrealestate.al>
SMTP_FROM=
# Inbox that receives contact form messages.
CONTACT_TO=
